# ============================================================================
# .env.example — medicamentos
# Copie para .env e preencha os valores obrigatórios
# ============================================================================

# === Database (OBRIGATÓRIO — para docker-compose) ===
# Gere uma senha forte: openssl rand -base64 18
DB_PASSWORD=""
DATABASE_URL="postgresql://admin:***@localhost:5432/medicamentos"

# === Authentication (OBRIGATÓRIO) ===
# Gere com: openssl rand -base64 32
AUTH_SECRET=""

# === Admin inicial (OBRIGATÓRIO — usado no seed) ===
ADMIN_EMAIL="admin@seudominio.com.br"
# Gere com: openssl rand -base64 12
ADMIN_PASSWORD=""

# === Site ===
# BASE_URL (server-only) — URL base para sitemap/robots/metadata.
BASE_URL="https://seudominio.com.br"
# NEXT_PUBLIC_BASE_URL (pública/inline) — mesma URL, prefixo NEXT_PUBLIC_ para
# que componentes client (ex.: JSON-LD do Breadcrumbs) usem o MESMO valor do
# servidor, evitando hydration mismatch. Mantenha igual ao BASE_URL.
NEXT_PUBLIC_BASE_URL="https://seudominio.com.br"

# === Conexão ANVISA ===
# Os servidores da ANVISA (dados.anvisa.gov.br) usam certificados ICP-Brasil que não
# constam nas CAs padrão do Linux/Node, causando 'UNABLE_TO_VERIFY_LEAF_SIGNATURE'.
# O bypass de verificação é escopado ao host ANVISA (src/lib/anvisa-https.ts) —
# NÃO existe mais variável global (NODE_TLS_REJECT_UNAUTHORIZED) para todo o processo.

# === Anvisa (opcionais — URLs públicas oficiais como fallback) ===
# ANVISA_MEDICINES_URL="https://dados.anvisa.gov.br/dados/CONSULTAS/PRODUTOS/TA_CONSULTA_MEDICAMENTOS.CSV"
# ANVISA_PRICES_URL="https://dados.anvisa.gov.br/dados/TA_PRECOS_MEDICAMENTOS.csv"
# ANVISA_THERAPEUTIC_CLASS_URL="https://dados.anvisa.gov.br/dados/DADOS_ABERTOS_MEDICAMENTOS.csv"

# === Embeddings (opcional) ===
# Modelo de embedding multilíngue
# small: 384 dims (118MB) | base: 768 dims (mais qualidade) | large: 1024 dims (melhor qualidade, mais lento)
EMBEDDING_MODEL="Xenova/multilingual-e5-base"
EMBEDDING_DIMS="768"

# === Retenção de logs (LGPD — purge, opcional) ===
# Dias de retenção para search_logs e search_feedback no `npm run purge:logs`
SEARCH_LOGS_RETENTION_DAYS="365"
SEARCH_FEEDBACK_RETENTION_DAYS="365"

# === MCP Server (opcional — endpoint /api/mcp, Model Context Protocol) ===
# false desliga a rota /api/mcp (404 em todos os métodos)
# MCP_ENABLED="true"
# Se preenchida, exige "Authorization: Bearer <chave>" em todas as requisições MCP
# MCP_API_KEY=""
# Origins adicionais permitidas (separadas por vírgula), além do BASE_URL
# MCP_ALLOWED_ORIGINS=""
# TTL de sessão MCP em minutos (renovação deslizante)
MCP_SESSION_TTL_MIN="60"
# true = respostas JSON puras (sem SSE) | false = SSE (spec Streamable HTTP)
MCP_ENABLE_JSON_RESPONSE="false"
# Limite de requisições MCP por minuto por IP
MCP_RATE_LIMIT="120"

# === Ambiente ===
NODE_ENV="production"
